generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
}

enum AccountType {
  BANK
  CASH
  CREDIT_CARD
  INVESTMENT
  OTHER
}

enum CategoryType {
  EXPENSE
  INCOME
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  email        String            @unique @db.VarChar(254)
  passwordHash String?           @map("password_hash")
  googleId     String?           @unique @map("google_id")
  imageUrl     String?           @map("image_url")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  memberships HouseholdMember[]
  transactions Transaction[]     @relation("TransactionCreator")

  @@map("users")
}

model Household {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(100)
  currency    String            @default("INR") @db.Char(3)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  members     HouseholdMember[]
  accounts    Account[]
  categories  Category[]
  transactions Transaction[]

  @@map("households")
}

model HouseholdMember {
  id          String         @id @default(uuid()) @db.Uuid
  householdId String         @map("household_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  role        HouseholdRole  @default(MEMBER)
  joinedAt    DateTime       @default(now()) @map("joined_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

model Account {
  id             String      @id @default(uuid()) @db.Uuid
  householdId    String      @map("household_id") @db.Uuid
  name           String      @db.VarChar(100)
  type           AccountType
  openingBalance Decimal     @default(0) @map("opening_balance") @db.Decimal(15, 2)
  currency       String      @default("INR") @db.Char(3)
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  household      Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions   Transaction[] @relation("TransactionAccount")

  @@index([householdId])
  @@index([householdId, isActive])
  @@map("accounts")
}

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  householdId String       @map("household_id") @db.Uuid
  name        String       @db.VarChar(100)
  type        CategoryType
  icon        String?      @db.VarChar(50)
  color       String?      @db.VarChar(20)
  parentId    String?      @map("parent_id") @db.Uuid
  isDefault   Boolean      @default(false) @map("is_default")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent      Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]   @relation("CategoryHierarchy")
  transactions Transaction[]

  @@unique([householdId, name, type])
  @@index([householdId, type])
  @@index([parentId])
  @@map("categories")
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  householdId     String          @map("household_id") @db.Uuid
  accountId       String          @map("account_id") @db.Uuid
  categoryId      String?         @map("category_id") @db.Uuid
  createdBy       String          @map("created_by") @db.Uuid
  transferId      String?         @map("transfer_id") @db.Uuid
  type            TransactionType
  amount          Decimal         @db.Decimal(15, 2)
  description     String          @db.VarChar(255)
  transactionDate DateTime        @map("transaction_date") @db.Date
  notes           String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   Account   @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator   User      @relation("TransactionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([householdId, transactionDate])
  @@index([householdId, accountId, transactionDate])
  @@index([householdId, categoryId, transactionDate])
  @@index([householdId, type, transactionDate])
  @@index([transferId])
  @@map("transactions")
}
