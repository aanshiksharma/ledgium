generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
}

enum AccountType {
  BANK
  CASH
  CREDIT_CARD
  INVESTMENT
  OTHER
}

enum DebtSourceType {
  HOUSEHOLD
  PERSONAL
}

enum DebtStatus {
  OPEN
  PARTIALLY_SETTLED
  SETTLED
  CANCELLED
}

model User {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  email         String            @unique @db.VarChar(254)
  refreshTokens RefreshToken[]
  passwordHash  String?           @map("password_hash")
  googleId      String?           @unique @map("google_id")
  imageUrl      String?           @map("image_url")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  memberships              HouseholdMember[]
  transactions             Transaction[]     @relation("TransactionCreator")
  createdHouseholdExpenses HouseholdExpense[] @relation("HouseholdExpenseCreator")
  expensePayers            ExpensePayer[]
  expenseParticipants      ExpenseParticipant[]
  debtorDebts              Debt[]             @relation("DebtDebtor")
  creditorDebts            Debt[]             @relation("DebtCreditor")
  settlementDebtsAsDebtor  DebtSettlement[]   @relation("DebtSettlementDebtor")
  settlementDebtsAsCreditor DebtSettlement[]  @relation("DebtSettlementCreditor")
  createdDebtSettlements   DebtSettlement[]   @relation("DebtSettlementCreator")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Household {
  id           String            @id @default(uuid()) @db.Uuid
  name         String            @db.VarChar(100)
  currency     String            @default("INR") @db.Char(3)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  members          HouseholdMember[]
  accounts         Account[]
  categories       Category[]
  transactions     Transaction[]
  householdExpenses HouseholdExpense[]

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @map("household_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

model Account {
  id             String        @id @default(uuid()) @db.Uuid
  householdId    String        @map("household_id") @db.Uuid
  name           String        @db.VarChar(100)
  type           AccountType
  openingBalance Decimal       @default(0) @map("opening_balance") @db.Decimal(15, 2)
  currency       String        @default("INR") @db.Char(3)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("TransactionAccount")

  @@index([householdId])
  @@index([householdId, isActive])
  @@map("accounts")
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  householdId String        @map("household_id") @db.Uuid
  name         String        @db.VarChar(100)
  icon         String?       @db.VarChar(50)
  color        String?       @db.VarChar(20)
  parentId     String?       @map("parent_id") @db.Uuid
  isDefault    Boolean       @default(false) @map("is_default")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  household        Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent           Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]        @relation("CategoryHierarchy")
  transactions     Transaction[]
  householdExpenses HouseholdExpense[]

  @@unique([householdId, name])
  @@index([householdId])
  @@index([parentId])
  @@map("categories")
}

model Transaction {
  id              String      @id @default(uuid()) @db.Uuid
  householdId     String      @map("household_id") @db.Uuid
  accountId       String      @map("account_id") @db.Uuid
  categoryId      String?     @map("category_id") @db.Uuid
  createdBy       String      @map("created_by") @db.Uuid
  transferId      String?     @map("transfer_id") @db.Uuid
  amount          Decimal     @db.Decimal(15, 2)
  description     String      @db.VarChar(255)
  transactionDate DateTime    @map("transaction_date") @db.Date
  notes           String?     @db.Text
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account     Account   @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator     User      @relation("TransactionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([householdId, transactionDate])
  @@index([householdId, accountId, transactionDate])
  @@index([householdId, categoryId, transactionDate])
  @@index([householdId, transferId])
  @@map("transactions")
}

model HouseholdExpense {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @map("household_id") @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  description String   @db.VarChar(255)
  totalAmount Decimal  @map("total_amount") @db.Decimal(15, 2)
  currency    String   @db.Char(3)
  expenseDate DateTime @map("expense_date") @db.Date
  notes       String?  @db.Text
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  household    Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator      User                @relation("HouseholdExpenseCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  payers       ExpensePayer[]
  participants ExpenseParticipant[]
  debts        Debt[]

  @@index([householdId, expenseDate])
  @@index([householdId, createdAt])
  @@index([householdId, categoryId])
  @@index([createdBy])
  @@map("household_expenses")
}

model ExpensePayer {
  id         String   @id @default(uuid()) @db.Uuid
  expenseId  String   @map("expense_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  paidAmount Decimal  @map("paid_amount") @db.Decimal(15, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  expense HouseholdExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_payers")
}

model ExpenseParticipant {
  id              String   @id @default(uuid()) @db.Uuid
  expenseId       String   @map("expense_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  shareAmount     Decimal  @map("share_amount") @db.Decimal(15, 2)
  sharePercentage Decimal? @map("share_percentage") @db.Decimal(7, 4)
  createdAt       DateTime @default(now()) @map("created_at")

  expense HouseholdExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_participants")
}

model Debt {
  id                 String         @id @default(uuid()) @db.Uuid
  debtorId           String         @map("debtor_id") @db.Uuid
  creditorId         String         @map("creditor_id") @db.Uuid
  amount             Decimal        @db.Decimal(15, 2)
  remainingAmount    Decimal        @map("remaining_amount") @db.Decimal(15, 2)
  currency           String         @db.Char(3)
  sourceType         DebtSourceType @map("source_type")
  householdExpenseId String?        @map("household_expense_id") @db.Uuid
  description        String         @db.VarChar(255)
  status             DebtStatus     @default(OPEN)
  isActive           Boolean        @default(true) @map("is_active")
  dueDate            DateTime?      @map("due_date") @db.Date
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  debtor           User             @relation("DebtDebtor", fields: [debtorId], references: [id], onDelete: Restrict)
  creditor         User             @relation("DebtCreditor", fields: [creditorId], references: [id], onDelete: Restrict)
  householdExpense HouseholdExpense? @relation(fields: [householdExpenseId], references: [id], onDelete: Restrict)
  settlementAllocations DebtSettlementAllocation[]

  @@index([debtorId, status])
  @@index([creditorId, status])
  @@index([debtorId, creditorId, isActive])
  @@index([householdExpenseId, isActive])
  @@index([householdExpenseId])
  @@index([sourceType, status])
  @@map("debts")
}

model DebtSettlement {
  id        String   @id @default(uuid()) @db.Uuid
  debtorId  String   @map("debtor_id") @db.Uuid
  creditorId String  @map("creditor_id") @db.Uuid
  amount    Decimal  @db.Decimal(15, 2)
  settledAt DateTime @map("settled_at") @db.Date
  createdBy String   @map("created_by") @db.Uuid
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  debtor     User @relation("DebtSettlementDebtor", fields: [debtorId], references: [id], onDelete: Restrict)
  creditor   User @relation("DebtSettlementCreditor", fields: [creditorId], references: [id], onDelete: Restrict)
  creator    User @relation("DebtSettlementCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  allocations DebtSettlementAllocation[]

  @@index([debtorId, settledAt])
  @@index([creditorId, settledAt])
  @@index([createdBy])
  @@map("debt_settlements")
}

model DebtSettlementAllocation {
  id           String @id @default(uuid()) @db.Uuid
  settlementId String @map("settlement_id") @db.Uuid
  debtId       String @map("debt_id") @db.Uuid
  amount       Decimal @db.Decimal(15, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  settlement DebtSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  debt       Debt @relation(fields: [debtId], references: [id], onDelete: Restrict)

  @@unique([settlementId, debtId])
  @@index([settlementId])
  @@index([debtId])
  @@map("debt_settlement_allocations")
}
